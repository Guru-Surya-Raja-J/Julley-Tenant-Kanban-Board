# Copy to .env to use. Every value is optional in development. In production, set the first three.

# Signs access tokens. Required when NODE_ENV=production.
JWT_SECRET=change-me

# The API's connection. Must be the role kanban_app, which cannot bypass row-level security.
DATABASE_URL=postgres://kanban_app:kanban_app@localhost:54329/kanban
# The owner's connection, used only by `npm run db:migrate` and `npm run db:seed`.
OWNER_DATABASE_URL=postgres://postgres:postgres@localhost:54329/kanban

PORT=4000
CORS_ORIGIN=http://localhost:5173
JWT_TTL_SECONDS=43200
AUTH_RATE_LIMIT=30

# Rewrite a column's rank keys once one grows past this length.
REBALANCE_KEY_LENGTH=48
# A client further behind than this reloads a snapshot instead of replaying.
MAX_REPLAY_EVENTS=500
WS_PING_INTERVAL_MS=30000
PRESENCE_HEARTBEAT_MS=10000
PRESENCE_TTL_MS=30000

# Where `npm start` keeps its local PostgreSQL data. Defaults to .pgdata in this folder.
# DEV_DATABASE_DIR=
# A built julley-frontend for this server to host as well.
# FRONTEND_DIST=../julley-frontend/dist
