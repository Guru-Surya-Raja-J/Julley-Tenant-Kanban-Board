{
  "name": "julley-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "concurrently -k -n db,api -c blue,green \"npm:db\" \"npm:api\"",
    "api": "nodemon src/index.js",
    "db": "node src/db/devServer.js",
    "start:prod": "node src/index.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "test": "node test/run.js",
    "lint": "eslint .",
    "simulate": "node scripts/simulate-team.js",
    "bench": "node scripts/bench.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "fractional-indexing": "^4.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14"
  }
}